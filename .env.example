# Netlify: set these in Site → Environment variables (never put ANTHROPIC_API_KEY in Zoho theme HTML).
ANTHROPIC_API_KEY=

# Optional: override model (default: claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Required for browser calls from your storefront: comma-separated exact origins (scheme + host + port)
# Example: https://yourstore.zohoecommerce.com,https://www.yourcustomdomain.com
ALLOWED_ORIGINS=

# Optional: if set, the theme widget must send header X-Widget-Secret: <same value>
WIDGET_SECRET=
