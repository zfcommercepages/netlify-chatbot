# Netlify: set these in Site → Environment variables.

# Required: comma-separated storefront origins (browser CORS)
ALLOWED_ORIGINS=

# Required: full URL of the agent receive webhook (POST JSON body below)
# Example: http://10.93.9.49:8000/webhooks/receive/agent/fd900c5a-017c-4d69-9218-5edbdb1af614
AGENT_WEBHOOK_URL=

# Optional: model name sent in the JSON body (default: claude-sonnet-4-6)
# AGENT_MODEL=claude-sonnet-4-6

# Optional: callback URL included as "endpoint" in the body (omit if not needed)
# AGENT_CALLBACK_ENDPOINT=https://webhook.site/your-uuid

# Optional: sampling_params overrides (defaults match typical agent API)
# AGENT_TEMPERATURE=0.3
# AGENT_TOP_P=0.9
# AGENT_TOP_K=15
# AGENT_MAX_TOKENS=768

# Optional: merge extra request headers (JSON object of string values), e.g. Origin for strict servers
# AGENT_EXTRA_HEADERS_JSON={"Origin":"http://zlabs-gamd11:5000"}

# Optional: if set, the theme widget must send header X-Widget-Secret: <same value>
WIDGET_SECRET=
